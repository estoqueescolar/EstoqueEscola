# Copie para .env.local e preencha. Nunca versione o .env.local.
# Valores locais: rode `npx supabase status` depois de `npx supabase start`.

# Públicas (vão para o navegador; a proteção dos dados é feita pelo RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54721
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# URL pública do site, usada nos links de e-mail (recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRETA: só no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role
